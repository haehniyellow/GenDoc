# 复制为 .env 后按需修改。.env 已被 .gitignore 忽略，请勿提交真实密钥。

# ── 服务 ──
ADDR=:8080
DATA_DIR=./data
# 登录令牌的签名密钥。生产环境必须设置为足够长的随机串；不设置时每次启动随机生成（重启后需重新登录）
JWT_SECRET=change-me-to-a-long-random-string
# 是否开放注册
ALLOW_REGISTER=true

# ── LLM（OpenAI 兼容接口：OpenAI / DeepSeek / 通义 / 智谱 / 自建网关 等）──
# 不设置 OPENAI_API_KEY 时自动使用内置 Mock 模型（固定模板，仅用于联调）
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# 即使配置了 key 也强制使用 Mock
LLM_MOCK=true
